# Email Configuration for AI Summary
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed to GitHub

# Flask session signing key - generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here

# Gmail SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=kt.vball.summary@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_DEFAULT_SENDER=kt.vball.summary@gmail.com

# Always receive a copy of every AI summary email (comma-separated for multiple)
AI_EMAIL_COPY_TO=idynkydnk@gmail.com

# Reply-To address on AI summary emails (defaults to first AI_EMAIL_COPY_TO address)
AI_EMAIL_REPLY_TO=idynkydnk@gmail.com

# Public site URL used in email links and List-Unsubscribe headers
SITE_BASE_URL=https://idynkydnk.pythonanywhere.com

# Website email sign-in uses the MAIL_* settings above (see docs/web-sign-in.md).
# Login codes are sent only to the person signing in, without recap copies.

# OpenAI is required for app/website generation and content moderation.
# Requests remain disabled until the signed-in account grants AI permission.
# OPENAI_API_KEY=sk-...
# Optional OpenAI model overrides:
# OPENAI_TEXT_MODEL=gpt-4.1
# OPENAI_RESPONSES_MODEL=gpt-4.1
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high
#
# Legacy standalone scripts only; never a fallback for app/website requests:
# GEMINI_API_KEY=your_gemini_api_key_here

# Public privacy/support contact; confirm this inbox is monitored before release.
STATS_SUPPORT_EMAIL=idynkydnk@gmail.com

# Published AI library targets per account (favorites and upcoming flyers are protected)
AI_RECAP_LIMIT=100
AI_FLYER_LIMIT=50

# Sign in with Apple server token exchange and account-deletion revocation.
# Set these on the server only; never put them in the iPhone bundle or Git.
# APPLE_IOS_CLIENT_ID=com.kt.stats
# APPLE_TEAM_ID=your_apple_developer_team_id
# APPLE_KEY_ID=your_sign_in_with_apple_key_id
# APPLE_PRIVATE_KEY_PATH=/private/server/path/AuthKey.p8
# Or set APPLE_PRIVATE_KEY to the PEM text instead of a path.
# Generate once and retain securely for decrypting existing refresh tokens:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APPLE_TOKEN_ENCRYPTION_KEY=your_generated_fernet_key
