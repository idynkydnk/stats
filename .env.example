# Email Configuration for AI Summary
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed to GitHub

# Flask session signing key - generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_secret_key_here

# Gmail SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=kt.vball.summary@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_DEFAULT_SENDER=kt.vball.summary@gmail.com

# Always receive a copy of every AI summary email (comma-separated for multiple)
AI_EMAIL_COPY_TO=idynkydnk@gmail.com

# Reply-To address on AI summary emails (defaults to first AI_EMAIL_COPY_TO address)
AI_EMAIL_REPLY_TO=idynkydnk@gmail.com

# Public site URL used in email links and List-Unsubscribe headers
SITE_BASE_URL=https://idynkydnk.pythonanywhere.com

# Website Apple and Google sign-in (see docs/web-sign-in.md).
# Use a Google Web application client from the same project as the iPhone app.
# GOOGLE_WEB_CLIENT_ID=your_web_client.apps.googleusercontent.com
# Use an Apple Services ID grouped with the iPhone app's primary App ID.
# APPLE_WEB_CLIENT_ID=your_services_id
# APPLE_WEB_REDIRECT_URI=https://idynkydnk.pythonanywhere.com/login

# AI providers (OpenAI preferred when set — higher-quality images via gpt-image-2)
# OPENAI_API_KEY=sk-...
# Optional OpenAI model overrides:
# OPENAI_TEXT_MODEL=gpt-4.1
# OPENAI_RESPONSES_MODEL=gpt-4.1
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=high
#
# Fallback / free-tier provider when OPENAI_API_KEY is unset:
# GEMINI_API_KEY=your_gemini_api_key_here

# Published AI library targets per account (favorites and upcoming flyers are protected)
AI_RECAP_LIMIT=100
AI_FLYER_LIMIT=50
